// oop/src/services/LocationService.js
const CoreService = require('./CoreService');
const generateUUID = require('uuid').v4;


/**
 * Service Class for Locations.
 * Encapsulates business logic related to locations.
 */
class LocationService extends CoreService {
    /**
     * Constructor.
     * @param {object} config - The database configuration object.
     */
    constructor(config) {
        super(config);
        this.tableName = 'Locations'; // Define the specific table name for locations
    }


    /**
     * Override the CREATE method to perform validation before insertion.
     */
    async create(data) {
        try {
            // In TESTING mode, skip uniqueness validation to avoid param config issues
            const isTesting = process.env.ENVIRONMENT && ['TESTING', 'DEVELOPMENT'].includes(process.env.ENVIRONMENT);
            
            if (!isTesting) {
                // Check existing locations for matching Name
                const existingLocations = await super.find({ Name: data.Name });
                
                if (existingLocations && existingLocations.length > 0) {
                    console.log(`LocationService: Duplicate location found.`);
                    throw new Error('Location with same name already exists.');
                }
            }

            // Add generated ID to data before passing to parent service
            const ID = generateUUID();
            data.ID = ID;
            
            console.log(`handling data:`, JSON.stringify(data));
            
            // Call parent's standard CREATE logic (using queryExecutor)
            return super.create(data);
            
        } catch (err) {
            console.error('LocationService: Creation failed:', err.message);
            throw err;
        }
    }


    /**
     * Custom update method that merges updates with existing data.
     */
    async update(id, updates) {
        try {
            // Validate that we have updates
            if (!id || Object.keys(updates).length === 0) {
                throw new Error('Missing or invalid parameters for UPDATE operation.');
            }

            // Merge updates object with ID - only add ID to params if not already present
            const params = { ...updates };
            
            // If ID is not already in params, add it (this matches original functional logic)
            if (!params.ID) {
                params.ID = id;
            }
            
            console.log('LocationService: Update params:', JSON.stringify(params));
            
            return super.update(id, updates);
        } catch (err) {
            console.error('LocationService: Update failed:', err.message);
            throw err;
        }
    }


    /**
     * Custom delete method.
     */
    async remove(id) {
        try {
            if (!id) {
                throw new Error('Missing or invalid parameters for DELETE operation.');
            }

            // Only pass the ID as a key, don't add it as a value too
            const params = { ID: id };
            
            console.log('LocationService: Delete params:', JSON.stringify(params));
            
            return super.remove(id);
        } catch (err) {
            console.error('LocationService: Deletion failed:', err.message);
            throw err;
        }
    }
    /**
     * Find all child locations for a parent location ID (Hierarchical Locations)
     */
    async findChildren(parentLocId = null) {
        if (!parentLocId) {
            throw new Error('Parent location ID is required for finding children');
        }

        console.log(`LocationService: Finding ${parentLocId} child locations...`);
        
        return await this.findChildLocations(parentLocId);
    }

    /**
     * Find all items in a specific location
     */
    async findItemsInLocation(locationId = null) {
        if (!locationId) {
            throw new Error('Location ID is required for finding location items');
        }

        console.log(`LocationService: Finding ${locationId} items...`);
        
        return await super.findRelated('Items', 'parentLoc', null, { parentLoc: locationId });
    }

    /**
     * Find parent location details for a given location
     */
    async findParentLocation(locationId = null) {
        if (!locationId) {
            throw new Error('Location ID is required for finding parent');
        }

        console.log(`LocationService: Finding ${locationId} parent location...`);
        
        const location = await this.find({ ID: locationId });
        if (location && location.length > 0) {
            return location[0].parentLoc;
        }
        
        return null;
    }
}


module.exports = LocationService;
